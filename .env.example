# Meta App settings - all three channels are Meta-owned. One app can do all.
# Facebook / Instagram: Graph API  ->  Page Access Token
# WhatsApp:              Cloud API  ->  WABA token + phone number id

# Webhook
VERIFY_TOKEN=my_secret_verify_token
APP_SECRET=your_app_secret

# Facebook Messenger (Page Access Token, starts with EAAG...)
PAGE_ACCESS_TOKEN=

# Instagram (permanent IG token from Graph API Explorer)
IG_ACCESS_TOKEN=

# WhatsApp Business Cloud API
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
# Optional: used to ignore echoes from your own number. Use + format, e.g. 15551234567
WA_OWN_NUMBER=

# App
PORT=4000
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
DB_FILE=data/omnichannel.db

# Default admin agent (created automatically on first run)
ADMIN_EMAIL=admin@omnichannel.local
ADMIN_PASSWORD=admin123

# Cloudflare R2 (S3-compatible) - OPTIONAL for local dev, MANDATORY for Render
# Render ka filesystem ephemeral hai. Bina R2 ke uploaded images/documents
# har redeploy/restart pe delete ho jayenge.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=REPLACE_WITH_R2_BUCKET_NAME
# Public bucket ya custom public path ke liye. Agar empty hai to R2 endpoint URL use hoga.
R2_PUBLIC_URL=https://pub-<hash>.r2.dev